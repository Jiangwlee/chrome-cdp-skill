#!/usr/bin/env bash
# pi-read-link [options] <url>
# Read one X or Reddit post URL and return a structured summary.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-read-link [options] <url>

Read one X (x.com) or Reddit post URL and return a structured summary or full text.

Arguments:
  <url>       A post URL from x.com or reddit.com

Options:
  -v               Verbose: show tool calls and LLM output in real time
  --format <fmt>   Output format: summary (default) or full
  --help           Show this help
EOF
}

VERBOSE=false
FORMAT=summary
ARGS=()
i=0
POSITIONAL_ARGS=("$@")
while [[ $i -lt ${#POSITIONAL_ARGS[@]} ]]; do
  arg="${POSITIONAL_ARGS[$i]}"
  case "$arg" in
    --help) usage; exit 0 ;;
    -v)     VERBOSE=true ;;
    --format)
      i=$((i+1))
      FORMAT="${POSITIONAL_ARGS[$i]}"
      ;;
    --format=*)
      FORMAT="${arg#--format=}"
      ;;
    *)      ARGS+=("$arg") ;;
  esac
  i=$((i+1))
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
  usage; exit 1
fi

# Validate format
if [[ "$FORMAT" != "summary" && "$FORMAT" != "full" ]]; then
  echo "Error: --format must be 'summary' or 'full'" >&2
  exit 1
fi

# Append format instruction to user query
USER_QUERY="${ARGS[0]} [output-format: ${FORMAT}]"

SKILL_DIR="$HOME/.agents/skills/chrome-cdp"
AGENT_FILE="$HOME/.pi/agent/agents/link-reader.md"

MODEL="$(awk -F': ' '/^model:/{print $2; exit}' "$AGENT_FILE")"
PROMPT="$(awk 'BEGIN{n=0} /^---/{n++; next} n>=2{print}' "$AGENT_FILE")"

if [[ "$VERBOSE" == true ]]; then
  pi --no-session --mode json \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "$USER_QUERY" | pi-watch
else
  pi --no-session --print \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "$USER_QUERY"
fi
