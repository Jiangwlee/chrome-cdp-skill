#!/usr/bin/env bash
# pi-taoguba-research [options] <topic>
# Conduct multi-round research on a topic using Taoguba search (10 rounds).
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-taoguba-research [options] <topic>

Conduct multi-round research on a topic using Taoguba (淘股吧) search.
Iterates search terms over 10 rounds based on findings, saves intermediate
results, and compiles a comprehensive research report.

Arguments:
  <topic>     The research topic (can be a stock, strategy, market concept, etc.)

Options:
  -v          Verbose: show tool calls and LLM output in real time
  --help      Show this help

Examples:
  pi-taoguba-research "情绪周期"
  pi-taoguba-research "宁德时代 2025"
  pi-taoguba-research "龙头战法" -v
EOF
}

VERBOSE=false
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --help) usage; exit 0 ;;
    -v)     VERBOSE=true ;;
    *)      ARGS+=("$arg") ;;
  esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
  usage; exit 1
fi

SKILL_DIR="$HOME/.agents/skills/chrome-cdp"
AGENT_FILE="$HOME/.pi/agent/agents/taoguba-researcher.md"

MODEL="$(awk -F': ' '/^model:/{print $2; exit}' "$AGENT_FILE")"
PROMPT="$(awk 'BEGIN{n=0} /^---/{n++; next} n>=2{print}' "$AGENT_FILE")"

if [[ "$VERBOSE" == true ]]; then
  pi --no-session --mode json \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "请对以下主题进行深度研究：${ARGS[*]}" | pi-watch
else
  pi --no-session --print \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "请对以下主题进行深度研究：${ARGS[*]}"
fi
