#!/usr/bin/env bash
# pi-wps [options] <question>
# Ask a question about your WPS 365 documents and get an answer.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pi-wps [options] <question>

Ask a question about your WPS 365 (365.kdocs.cn) documents.
The agent will try WPS AI Docs Chat first, then fall back to document search and reading when needed.

Arguments:
  <question>  A question or search query about your documents

Options:
  -v          Verbose: show tool calls and LLM output in real time
  --help      Show this help

Examples:
  pi-wps "Q3 销售目标是多少"
  pi-wps "找一下关于产品路线图的文档"
  pi-wps -v "API 接口文档在哪里"
EOF
}

VERBOSE=false
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --help) usage; exit 0 ;;
    -v)     VERBOSE=true ;;
    *)      ARGS+=("$arg") ;;
  esac
done

if [[ ${#ARGS[@]} -eq 0 ]]; then
  usage; exit 1
fi

SKILL_DIR="$HOME/.agents/skills/chrome-cdp"
AGENT_FILE="$HOME/.pi/agent/agents/wps-assistant.md"

MODEL="$(awk -F': ' '/^model:/{print $2; exit}' "$AGENT_FILE")"
PROMPT="$(awk 'BEGIN{n=0} /^---/{n++; next} n>=2{print}' "$AGENT_FILE")"

if [[ "$VERBOSE" == true ]]; then
  pi --no-session --mode json \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "${ARGS[@]}" | pi-watch
else
  pi --no-session --print \
     --skill "$SKILL_DIR" \
     --tools bash,read \
     --model "$MODEL" \
     --system-prompt "$PROMPT" \
     "${ARGS[@]}"
fi
